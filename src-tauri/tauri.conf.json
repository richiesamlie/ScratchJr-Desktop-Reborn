{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScratchJr",
  "version": "2.7.1",
  "identifier": "org.scratchjr.desktop",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run build:renderer",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ScratchJr",
        "width": 1024,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "url": "app/index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' blob: data: ipc:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "../src/icons/png/32x32.png",
      "../src/icons/png/128x128.png",
      "../src/icons/png/256x256.png",
      "../src/icons/png/512x512.png",
      "../src/icons/win/icon.ico"
    ]
  }
}
