{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "src/app/dist/**",
    "src/app/svglibrary/**",
    "src/app/pnglibrary/**",
    "build/**",
    "dist-web/**",
    "out/**",
    "node_modules/**"
  ],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-this-alias": "off",
    "no-unused-vars": [
      "error",
      {
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "radix": "error",
    "default-case": "error",
    "no-eval": "error",
    "no-new-func": "error",
    "no-implied-eval": "error",
    "no-script-url": "error",
    "no-proto": "error",
    "no-with": "error",
    "no-unassigned-vars": "error",
    "no-useless-escape": "error",
    "oxc/erasing-op": "error",
    "unicorn/no-new-array": "error",
    "import/no-cycle": "off"
  },
  "overrides": [
    {
      "files": [
        "src/main/**/*.ts",
        "src/lib/**/*.ts",
        "src/main.ts",
        "src/preload.ts",
        "src/*.js",
        "src/app/*.js"
      ],
      "rules": {
        "eqeqeq": [
          "error",
          "always",
          {
            "null": "ignore"
          }
        ],
        "guard-for-in": "error",
        "no-shadow": "error",
        "import/no-cycle": "error"
      }
    }
  ]
}
