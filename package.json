{
    "name": "ScratchJr",
    "productName": "ScratchJr",
    "version": "2.14.2",
    "description": "ScratchJr Desktop Edition",
    "main": "build/main.js",
    "scripts": {
        "start": "electron-forge start",
        "debugMain": "electron-forge start -i",
        "make": "electron-forge make",
        "make:zip": "node scripts/package-and-zip.js",
        "lint": "eslint src --color",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
        "smoke": "node scripts/smoke-test.js",
        "interact": "node scripts/interaction-test.js",
        "build:main": "tsc -p tsconfig.main.json",
        "build:renderer": "node scripts/build-renderer.js",
        "build:android": "node scripts/build-android-assets.js",
        "build:web": "node scripts/build-web.js",
        "serve:web": "node scripts/serve-web.js",
        "tauri": "node scripts/run-tauri.js",
        "tauri:dev": "node scripts/run-tauri.js dev",
        "tauri:build": "node scripts/run-tauri.js build",
        "package:tauri": "node scripts/package-tauri.js",
        "postinstall": "node scripts/patch-for-node26.js && node scripts/build-renderer.js"
    },
    "keywords": [],
    "author": "ScratchJr - Open Source Community Port",
    "license": "BSD-3-Clause",
    "app-copyright": "Copyright (c) 2016, Massachusetts Institute of Technology",
    "engines": {
        "node": ">=26.0.0"
    },
    "config": {
        "forge": "./forge.config.js"
    },
    "dependencies": {
        "sql.js": "^1.15.1"
    },
    "devDependencies": {
        "@electron-forge/cli": "^8.0.1",
        "@electron-forge/maker-zip": "^8.0.1",
        "@electron/packager": "^20.3.0",
        "@tauri-apps/cli": "^2.12.4",
        "@types/node": "^26.6.5",
        "@vitest/coverage-v8": "^5.0.5",
        "electron": "^45.0.0",
        "electron-wix-msi": "^5.1.3",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "eslint-import-resolver-node": "^0.4.0",
        "eslint-plugin-import-x": "^4.17.1",
        "globals": "^17.13.0",
        "intl-messageformat": "^12.1.4",
        "jsdom": "^30.1.3",
        "jszip": "^3.10.2",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    },
    "overrides": {
        "tar": "^7.5.21",
        "tmp": "^0.2.6"
    }
}
